    <string name="help_getting_started">Getting started</string>
    <string name="help_getting_started_body">The app opens directly in the prompt editor. Swipe right for generation settings and left for the latest result or History.</string>
    <string name="help_previous_work">Previous Work</string>
    <string name="help_previous_work_body">Previous Work swaps the current generation job with the last stashed job. It restores prompts and generation parameters, but never changes global Settings such as theme, storage, token, or autocomplete source.</string>
    <string name="help_novelai_setup">NovelAI setup</string>
    <string name="help_novelai_setup_body">Enter a NovelAI Persistent Token under NovelAI connection and run Test connection. The token is stored using Android Keystore and is excluded from backup files.</string>
    <string name="help_prompt_formatter">Prompt &amp; formatter</string>
    <string name="help_prompt_formatter_body">Only enabled Blocks are sent. Comments inside ## markers are removed during generation. Formatter actions preserve weight and randomizer regions.</string>
    <string name="help_color_helper">Color Helper</string>
    <string name="help_color_helper_body">Choose colors with Hue, Saturation and Value or enter HEX directly. You can save favorites, reuse recent colors, copy a value, or insert it at the current prompt cursor. Its shortcut visibility is configurable in Settings. HEX colors guide the model and do not guarantee an exact RGB pixel color.</string>
    <string name="help_generation">Generation</string>
    <string name="help_generation_body">Model, resolution, sampler, steps, guidance and seed are job-specific settings. Random seed is chosen locally before the request so the used seed can be stored in History.</string>
    <string name="help_library_history">Library, History &amp; Previous Work</string>
    <string name="help_library_history_body">Library stores reusable Blocks, Sets and Presets. History stores immutable generation snapshots. Restoring either stashes the current job so Previous Work can bring it back.</string>
    <string name="help_saving_images">Saving images</string>
    <string name="help_saving_images_body">Generated originals use the selected folder. If permission is revoked or a file is moved, History keeps its thumbnail but may not open the original.</string>
    <string name="help_backup_body">Backup includes global Settings, current and previous work, Library items, History metadata and thumbnails, and user Tag DB data. API tokens and original generated images are excluded.</string>
    <string name="help_troubleshooting">Troubleshooting</string>
    <string name="help_troubleshooting_body">For authentication errors, save the token and test the connection first. Network and API errors do not modify the current editor state and can be retried with the same prompt, settings and seed.</string>
